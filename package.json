{
  "name": "hsl-map-publisher",
  "version": "1.2.6",
  "description": "HSL Map Publisher",
  "main": "index.js",
  "scripts": {
    "eslint-check": "eslint --print-config . | eslint-config-prettier-check",
    "prettier": "prettier \"src/**/*.{js,css}\" \"scripts/**/*.js\" \"migrations/**/*.js\" \"seeds/**/*.js\" \"*.js\" --write",
    "lint:mega": "npx --yes mega-linter-runner@9 --flavor all --release v9.6.0",
    "lint:mega:fix": "npx --yes mega-linter-runner@9 --flavor all --release v9.6.0 --fix",
    "lint:mega:changed": "npx --yes mega-linter-runner@9 --flavor all --release v9.6.0 -e VALIDATE_ALL_CODEBASE=false",
    "lint": "eslint \"src/**/*.js\" \"scripts/**/*.js\" --fix",
    "lint:check": "eslint \"src/**/*.js\" \"scripts/**/*.js\" && prettier --check \"src/**/*.{js,css}\" \"scripts/**/*.js\" \"migrations/**/*.js\" \"seeds/**/*.js\" \"*.js\"",
    "build": "cross-env NODE_ENV=production webpack --config webpack.prod.js",
    "test:unit": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info --test-reporter=junit --test-reporter-destination=junit.xml \"test/**/*.test.mjs\"",
    "check-and-build": "npm run lint:check && npm run test:unit && npm run build",
    "serve": "serve -l 5000 dist",
    "start": "webpack serve --config webpack.dev.js",
    "start:production": "serve -l 5000 dist",
    "server": "node -r dotenv/config scripts/server",
    "server:production": "node scripts/server.js",
    "worker": "node -r dotenv/config scripts/worker",
    "worker:production": "./fonts.sh && fc-cache -f -v && node scripts/worker.js",
    "knex": "node -r dotenv/config node_modules/knex/bin/cli.js",
    "docker:build": "docker build -t hsl-map-publisher .",
    "docker:run": "docker run -d -p 4000:4000 --name publisher -v $(pwd)/output:/output -v $(pwd)/fonts:/fonts --link publisher-postgres --env-file .env.local --shm-size=1G hsl-map-publisher",
    "docker:stop": "docker stop publisher",
    "docker:rm": "docker rm publisher",
    "docker:rebuild": "npm run docker:stop && npm run docker:rm && npm run docker:build && npm run docker:run",
    "docker:logs": "docker logs publisher",
    "prepare": "husky install",
    "test": "node test/tests"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.css": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HSLdevcom/hsl-map-publisher.git"
  },
  "author": "",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/HSLdevcom/hsl-map-publisher/issues"
  },
  "homepage": "https://github.com/HSLdevcom/hsl-map-publisher#readme",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "fbjs": "^3.0.5",
    "isomorphic-fetch": {
      "node-fetch": "^2.7.0"
    },
    "basic-ftp": "^5.2.1",
    "browserslist": "4.28.7",
    "compression": "1.8.2",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "babel-loader": "^10.1.1",
    "babel-plugin-transform-object-rest-spread": "^6.26.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.8.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-webpack": "^0.13.11",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0",
    "worker-loader": "^3.0.8"
  },
  "dependencies": {
    "@azure/storage-blob": "^10.4.0",
    "@koa/cors": "^5.0.0",
    "@turf/turf": "^6.5.0",
    "apollo-cache-inmemory": "^1.1.1",
    "apollo-client": "^2.0.3",
    "apollo-link": "^1.2.2",
    "apollo-link-http": "^1.2.0",
    "assert": "^2.1.0",
    "babel-polyfill": "^6.26.0",
    "bullmq": "^1.86.2",
    "cheerio": "^1.0.0",
    "classnames": "^2.2.5",
    "clean-webpack-plugin": "^4.0.0",
    "dotenv": "^8.1.0",
    "dotenv-webpack": "^8.1.0",
    "fs-extra": "9.0.0",
    "graphql": "^0.11.7",
    "graphql-tag": "^2.5.0",
    "haversine": "^1.1.1",
    "hsl-map-style": "hsldevcom/hsl-map-style#master",
    "html-webpack-plugin": "^5.6.3",
    "ioredis": "^5.0.6",
    "knex": "^2.0.0",
    "koa": "^2.16.4",
    "koa-body": "^6.0.1",
    "koa-json-body": "^5.3.0",
    "koa-router": "^7.4.0",
    "koa-session": "6.0.0",
    "lodash": "^4.18.1",
    "moment": "^2.29.4",
    "node-fetch": "^2.7.0",
    "p-map": "^1.2.0",
    "pdf-merger-js": "^3.4.0",
    "pg": "^8.7.3",
    "prop-types": "^15.6.0",
    "puppeteer": "^25.12.0",
    "qrcode": "^1.5.4",
    "qs": "^6.5.2",
    "raw-loader": "^0.5.1",
    "react": "18.2.0",
    "react-apollo": "^2.0.1",
    "react-csv": "^2.2.2",
    "react-dom": "18.2.0",
    "react-measure": "^2.5.2",
    "recompose": "^0.30.0",
    "segseg": "^0.2.2",
    "serve": "^14.2.6",
    "style-loader": "^3.3.4",
    "uuid": "^3.1.0",
    "viewport-mercator-project": "^4.1.1",
    "webpack": "^5.99.0",
    "webpack-merge": "^6.0.1"
  }
}
